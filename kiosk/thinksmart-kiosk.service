# Do not enable this unit. The face runs under SDDM autologin
# (thinksmart-kiosk.desktop → cage). A second cage on graphical.target
# fights the session and has no seat.
[Unit]
Description=ThinkSmart face kiosk (cage) — unused; SDDM owns the session
After=graphical.target

[Service]
User=ubuntu
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/bin/cage -s /usr/local/share/thinksmart-kiosk/thinksmart-face.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
