# Copy to kiosk.env (gitignored) or /etc/thinksmart-kiosk.env and chmod 600.
# The panel talks to xAI directly. This file holds the API key.

XAI_API_KEY=
CLOCK_TZ=America/Chicago
SCREEN_IDLE_SEC=60
# Optional: city for web_search location (default Denver)
SEARCH_CITY=Denver
SEARCH_COUNTRY=US
SEARCH_TZ=America/Denver
MCP_URL=https://gw.mattbrewer.me/mcp
MCP_LABEL=home-assistant
# Cloudflare Access service token for grok-voice (not committed).
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Optional JPEG face streamer. Empty = bundled stills only.
# FACE_STREAM=http://192.168.1.10:8766
